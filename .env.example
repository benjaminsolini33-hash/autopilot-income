# Copy to .env locally and fill only with credentials for services you have chosen.
# NEVER commit real values or share them in chat.

# Optional PostgreSQL database for a future self-hosted backend
DATABASE_URL=

# Optional AI provider key, only if you choose a provider and authorize its use
AI_API_KEY=

# Optional dedicated bearer token for a private MCP endpoint
AUTOPILOT_MCP_TOKEN=

# Public app URL when a hosting provider is selected
APP_BASE_URL=
